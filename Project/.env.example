# Public URLs
# Local defaults are safe for development. Set these to the real public hosts on the VPS.
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CHATGPT_CONNECTOR_PUBLIC_URL=http://localhost:8010

# Frontend / Supabase
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot_username
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CUSTOMER_TOKEN_ENCRYPTION_KEY=change-this-customer-token-key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Database
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_influencer
CHATGPT_CONNECTOR_DATABASE_URL=${DATABASE_URL}

# OpenAI / Anthropic API Keys
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Media Generation APIs
FAL_AI_API_KEY=your_fal_ai_key
GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_TTS_API_KEY=your_google_tts_key
HEYGEN_API_KEY=your_heygen_key

# Object Storage
# Supabase Storage is the default backend for generated media. The bucket should
# be public because publishing providers fetch assets by URL. The backend stores
# persona-scoped media under users/<user_id>/personas/<persona_id>/...
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=media
# Optional override if you front Storage with a custom CDN/domain.
# SUPABASE_STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/media
STORAGE_CACHE_CONTROL_SECONDS=3600
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_HTTP_TIMEOUT_SECONDS=30
STORAGE_UPSERT=true

# Legacy S3-compatible / Cloudflare R2 fallback
# Only keep these if you intentionally run STORAGE_PROVIDER=s3.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=media
R2_PUBLIC_URL=your_r2_public_url
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://media.yourdomain.com

# IPRoyal Proxy Configuration
IPROYAL_USERNAME=your_proxy_username
IPROYAL_PASSWORD=your_proxy_password
IPROYAL_PROXY_HOST=geo.iproyal.com
IPROYAL_PROXY_PORT=12321
PROXY_ENABLED=true
PROXY_SERVER=geo.iproyal.com:12321
PROXY_INVENTORY=
BROWSER_PROFILE_ROOT=/app/browser_profiles
DEFAULT_PROXY_REGION_CODE=US
DEFAULT_PROXY_LOCALE=en-US
DEFAULT_PROXY_TIMEZONE=America/New_York

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token header.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-this-telegram-webhook-secret

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-influencer-tasks
WORKER_CONCURRENCY=10

# OpenClaw / Connector
OPENCLAW_API_URL=http://localhost:8081
OPENCLAW_API_KEY=your_openclaw_api_key
OPENCLAW_AGENT_ID=main
OPENCLAW_MISSION_CONTROL_URL=http://localhost:8081
CHATGPT_CONNECTOR_SESSION_SECRET=change-this-connector-secret
# Leave unset in staging/production unless you explicitly accept the risk of
# self-issued connector sessions without a real external identity provider.
# CHATGPT_CONNECTOR_ALLOW_INSECURE_SELF_ISSUED_OAUTH=false
OPENAI_OAUTH_CLIENT_ID=your_openai_oauth_client_id
OPENAI_OAUTH_CLIENT_SECRET=your_openai_oauth_client_secret
OPENAI_OAUTH_REDIRECT_URI=${CHATGPT_CONNECTOR_PUBLIC_URL}/oauth/callback

# Python Backend
PYTHON_BACKEND_URL=http://localhost:8000

# Postiz Configuration
POSTIZ_API_URL=http://localhost:3100
POSTIZ_API_KEY=your_postiz_api_key
CUSTOMER_POSTIZ_FALLBACK_ENABLED=true
# Set explicit integration ids when multiple Postiz accounts exist for the same provider.
POSTIZ_INTEGRATION_MAP=
POSTIZ_WEBHOOK_SECRET=change-this-postiz-webhook-secret

# Customer OAuth Providers
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# GrowChief Configuration
GROWCHIEF_API_URL=http://localhost:3200
GROWCHIEF_API_KEY=your_growchief_api_key
# Required in production once GrowChief has more than one active workflow.
GROWCHIEF_WORKFLOW_MAP=
GROWCHIEF_WEBHOOK_SECRET=change-this-growchief-webhook-secret

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
DEFAULT_AI_MODEL=gpt-4
JWT_SECRET_KEY=change-this-in-production
APP_ADMIN_TOKEN=change-this-admin-token
INTERNAL_API_TOKEN=change-this-internal-api-token
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Workflow Configuration
WEEKLY_WORKFLOW_ENABLED=true
APPROVAL_TIMEOUT_DAYS=7
ENGAGEMENT_DELAY_HOURS=2
STEALTH_ACCOUNT_COUNT=5

# API Quota Monitoring
API_QUOTA_LOOKBACK_DAYS=30
API_QUOTA_ALERT_THRESHOLD=80
API_QUOTA_REFRESH_TTL_SECONDS=60
OPENAI_MONTHLY_TOKEN_LIMIT=
ANTHROPIC_MONTHLY_TOKEN_LIMIT=
GOOGLE_AI_MONTHLY_TOKEN_LIMIT=
GOOGLE_TTS_MONTHLY_CHAR_LIMIT=
FAL_AI_MONTHLY_REQUEST_LIMIT=
HEYGEN_MONTHLY_JOB_LIMIT=

# Production defaults for the internal-v1 VPS rollout:
# FRONTEND_PUBLIC_URL=https://ai-influencer.tripc.ai
# BACKEND_PUBLIC_URL=https://api.ai-influencer.tripc.ai
# CHATGPT_CONNECTOR_PUBLIC_URL=https://connector.ai-influencer.tripc.ai
# NEXT_PUBLIC_API_URL=https://ai-influencer.tripc.ai
# PYTHON_BACKEND_URL=http://backend:8000
# OPENAI_OAUTH_REDIRECT_URI=https://connector.ai-influencer.tripc.ai/oauth/callback
# CORS_ORIGINS=https://ai-influencer.tripc.ai,https://api.ai-influencer.tripc.ai,https://connector.ai-influencer.tripc.ai
#
# Single-domain alternative if only ai-influencer.tripc.ai is available:
# FRONTEND_PUBLIC_URL=https://ai-influencer.tripc.ai
# BACKEND_PUBLIC_URL=https://ai-influencer.tripc.ai/backend
# CHATGPT_CONNECTOR_PUBLIC_URL=https://ai-influencer.tripc.ai/connector
# NEXT_PUBLIC_API_URL=https://ai-influencer.tripc.ai
# PYTHON_BACKEND_URL=http://backend:8000
# OPENAI_OAUTH_REDIRECT_URI=https://ai-influencer.tripc.ai/connector/oauth/callback
# CORS_ORIGINS=https://ai-influencer.tripc.ai
