# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI / Claude API Keys
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Media Generation APIs
FAL_AI_API_KEY=your_fal_ai_key
GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_TTS_API_KEY=your_google_tts_key
HEYGEN_API_KEY=your_heygen_key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=ai-influencer-media
R2_PUBLIC_URL=your_r2_public_url

# IPRoyal Proxy Configuration
IPROYAL_USERNAME=your_proxy_username
IPROYAL_PASSWORD=your_proxy_password
IPROYAL_PROXY_HOST=geo.iproyal.com
IPROYAL_PROXY_PORT=12321

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# OpenClaw Configuration
OPENCLAW_API_URL=http://localhost:8080
OPENCLAW_API_KEY=your_openclaw_api_key
OPENCLAW_MISSION_CONTROL_URL=http://localhost:8081

# Python Backend
PYTHON_BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_influencer
SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
SUPABASE_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# Postiz Configuration (Self-hosted)
POSTIZ_API_URL=http://localhost:3100
POSTIZ_API_KEY=your_postiz_api_key

# GrowChief Configuration (Self-hosted)
GROWCHIEF_API_URL=http://localhost:3200
GROWCHIEF_API_KEY=your_growchief_api_key

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
DEFAULT_AI_MODEL=gpt-4
JWT_SECRET_KEY=change-this-in-production

# Workflow Configuration
WEEKLY_WORKFLOW_ENABLED=true
APPROVAL_TIMEOUT_DAYS=7
ENGAGEMENT_DELAY_HOURS=2
STEALTH_ACCOUNT_COUNT=5
PROXY_ENABLED=true
PROXY_SERVER=geo.iproyal.com:12321

# Storage Settings
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://media.yourdomain.com
